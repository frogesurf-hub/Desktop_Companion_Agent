# Desktop Companion Agent environment configuration template.
#
# Copy this file to ".env" for local development.
# Never commit real API keys or credentials.

DCA_ENVIRONMENT=development

DCA_RUNTIME_MODE=hybrid

DCA_WEBSOCKET_HOST=127.0.0.1
DCA_WEBSOCKET_PORT=8765

DCA_EVENT_BUS_QUEUE_CAPACITY=256

DCA_WORKING_CONTEXT_RETENTION_DAYS=7

DCA_AUTOMATIC_LEARNING_ENABLED=true

DCA_MODEL_PROVIDER=deepseek

DCA_DEEPSEEK_API_KEY=
DCA_DEEPSEEK_MODEL=deepseek-flash
DCA_DEEPSEEK_TIMEOUT_SECONDS=60
DCA_DEEPSEEK_THINKING_ENABLED=false

DCA_LOG_LEVEL=INFO
# Memory defaults to the operating system user-data directory.
# Set this only when an explicit database location override is required.
# DCA_MEMORY_DATABASE_PATH=<absolute path to memory.db>
