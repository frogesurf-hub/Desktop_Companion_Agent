<Window x:Class="DesktopCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Companion"
        Width="960"
        Height="640"
        MinWidth="760"
        MinHeight="520">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Connection status -->
        <Border Grid.Row="0"
                Padding="12"
                BorderThickness="1"
                BorderBrush="Gray"
                CornerRadius="6">

            <DockPanel>

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">

                    <TextBlock Text="Agent Core:"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{Binding ConnectionStatus}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />

                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Width="100"
                        Height="30"
                        Content="Connect"
                        Click="ConnectButton_Click" />

            </DockPanel>

        </Border>

        <TabControl Grid.Row="1"
                    Margin="0,16,0,0">

            <!-- Chat -->
            <TabItem Header="Chat">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             Margin="0,0,0,12"
                             Padding="8"
                             ItemsSource="{Binding Messages}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <TextBlock Text="{Binding}"
                                           Margin="4"
                                           TextWrapping="Wrap" />

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Height="36"
                                 Margin="0,0,10,0"
                                 Padding="8"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding InputText,
                                     UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1"
                                Width="90"
                                Height="36"
                                Content="Send"
                                IsEnabled="{Binding IsConnected}"
                                Click="SendButton_Click" />

                    </Grid>

                </Grid>

            </TabItem>

            <!-- Memory -->
            <TabItem Header="Memory"
                     DataContext="{Binding Memory}">

                <Grid Margin="12">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,12">

                        <Button DockPanel.Dock="Left"
                                Width="90"
                                Height="30"
                                Content="Refresh"
                                IsEnabled="{Binding CanOperate}"
                                Click="RefreshMemoryButton_Click" />

                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}" />

                    </DockPanel>

                    <!-- Main Memory area -->
                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Memory list -->
                        <Border Grid.Column="0"
                                Padding="8"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4">

                            <Grid>

                                <ListBox x:Name="MemoryList"
                                         ItemsSource="{Binding Memories}"
                                         SelectedItem="{Binding SelectedMemory,
                                             Mode=TwoWay}"
                                         SelectionChanged="MemoryList_SelectionChanged">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <StackPanel Margin="4">

                                                <TextBlock Text="{Binding Domain}"
                                                           FontWeight="SemiBold" />

                                                <TextBlock Text="{Binding LatestRevision.Content}"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Text="{Binding Scope.Kind}"
                                                           Margin="0,3,0,0"
                                                           Foreground="Gray"
                                                           FontSize="11" />

                                            </StackPanel>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>

                                <TextBlock Text="No Memory entries."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="Gray"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Border>

                        <!-- Detail -->
                        <ScrollViewer Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto">

                            <StackPanel>

                                <TextBlock Text="Memory Detail"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="Memory ID"
                                           FontWeight="SemiBold" />

                                <TextBox Margin="0,4,0,10"
                                         IsReadOnly="True"
                                         Text="{Binding SelectedMemory.MemoryId}" />

                                <TextBlock Text="Domain"
                                           FontWeight="SemiBold" />

                                <TextBox Margin="0,4,0,10"
                                         IsReadOnly="True"
                                         Text="{Binding SelectedMemory.Domain}" />

                                <TextBlock Text="Scope"
                                           FontWeight="SemiBold" />

                                <TextBox Margin="0,4,0,10"
                                         IsReadOnly="True"
                                         Text="{Binding SelectedMemory.Scope.Kind}" />

                                <TextBlock Text="Source"
                                           FontWeight="SemiBold" />

                                <TextBox Margin="0,4,0,10"
                                         IsReadOnly="True"
                                         Text="{Binding SelectedMemory.LatestRevision.Source}" />

                                <TextBlock Text="Lifecycle"
                                           FontWeight="SemiBold" />

                                <TextBox Margin="0,4,0,10"
                                         IsReadOnly="True"
                                         Text="{Binding SelectedMemory.LatestRevision.Lifecycle}" />

                                <TextBlock Text="Recorded At"
                                           FontWeight="SemiBold" />

                                <TextBox Margin="0,4,0,10"
                                         IsReadOnly="True"
                                         Text="{Binding SelectedMemory.LatestRevision.RecordedAt}" />

                                <TextBlock Text="Content"
                                           FontWeight="SemiBold" />

                                <TextBox Height="120"
                                         Margin="0,4,0,12"
                                         Padding="8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         IsEnabled="{Binding HasSelection}"
                                         Text="{Binding SelectedMemoryContent,
                                             UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Orientation="Horizontal">

                                    <Button Width="90"
                                            Height="30"
                                            Content="Save"
                                            IsEnabled="{Binding CanSave}"
                                            Click="SaveMemoryButton_Click" />

                                    <Button Width="90"
                                            Height="30"
                                            Margin="8,0,0,0"
                                            Content="Delete"
                                            IsEnabled="{Binding CanDelete}"
                                            Click="DeleteMemoryButton_Click" />

                                    <Button Width="90"
                                            Height="30"
                                            Margin="8,0,0,0"
                                            Content="History"
                                            IsEnabled="{Binding CanLoadHistory}"
                                            Click="HistoryMemoryButton_Click" />

                                </StackPanel>

                                <!-- History -->
                                <Border Margin="0,16,0,0"
                                        Padding="10"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        CornerRadius="4">

                                    <Border.Style>
                                        <Style TargetType="Border">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHistoryVisible}"
                                                             Value="True">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                </DataTrigger>
                                            </Style.Triggers>

                                        </Style>
                                    </Border.Style>

                                    <StackPanel>

                                        <DockPanel Margin="0,0,0,8">

                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="History"
                                                       FontWeight="SemiBold" />

                                            <Button DockPanel.Dock="Right"
                                                    Width="60"
                                                    Content="Close"
                                                    Click="CloseHistoryButton_Click" />

                                        </DockPanel>

                                        <ListBox MaxHeight="180"
                                                 ItemsSource="{Binding History}">

                                            <ListBox.ItemTemplate>
                                                <DataTemplate>

                                                    <StackPanel Margin="4">

                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="Revision " />
                                                            <Run Text="{Binding RevisionNumber}" />
                                                        </TextBlock>

                                                        <TextBlock Text="{Binding Lifecycle}"
                                                                   Foreground="Gray" />

                                                        <TextBlock Text="{Binding Content}"
                                                                   Margin="0,3,0,0"
                                                                   TextWrapping="Wrap" />

                                                    </StackPanel>

                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </ScrollViewer>

                    </Grid>

                    <!-- Error -->
                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,0"
                               Foreground="Firebrick"
                               TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" />

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>
</Window>
